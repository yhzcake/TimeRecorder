<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TimeRecorder" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#356859</item>
        <item name="android:navigationBarColor">#F7F8F5</item>
        <item name="android:statusBarColor">#F7F8F5</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">#F7F8FA</item>
    </style>
    <style name="Theme.TimeRecorder.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F7F8FA</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_time_recorder</item>
        <item name="postSplashScreenTheme">@style/Theme.TimeRecorder</item>
    </style>
</resources>
